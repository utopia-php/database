#!/usr/bin/env bash
# Restore corrupted adapter sources on branch cursor-cloud-3rat-string-byte-ef36.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

git fetch origin 4dc08150de3735c25df678150d78a044f879db4a

git checkout 4dc08150de3735c25df678150d78a044f879db4a -- \
  src/Database/Adapter/Redis.php \
  src/Database/Adapter/SQLite.php \
  tests/e2e/Adapter/Scopes/DocumentTests.php

git apply .github/CLOUD-3RAT-restore-sources.patch

rm -f .github/_mcp_size_test.txt .github/restore-test.txt

echo "Restored sources. Review with git diff --stat, then commit and push."
